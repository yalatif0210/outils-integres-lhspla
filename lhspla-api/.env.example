# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/lhspla_bulletin?schema=public"

# JWT
JWT_SECRET="change-this-to-a-very-long-random-secret-key-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-this-refresh-secret-also-very-long"
JWT_REFRESH_EXPIRES_IN="7d"

# App
PORT=3000
FRONTEND_URL="http://localhost:4201"

# Email (SMTP)
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=587
MAIL_USER="your-email@gmail.com"
MAIL_PASS="your-app-password"
MAIL_FROM="LHSPLA Bulletin <noreply@npsp.ci>"

# Deadline alert (cron: every Monday at 8:00 AM)
SUBMISSION_DEADLINE_HOUR=9

# LLM — Génération sections B/C/D du Weekly Operations Brief
# Claude : utilisé si ANTHROPIC_API_KEY est renseignée — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""
# Mistral : utilisé si pas de clé Anthropic — https://console.mistral.ai/api-keys
MISTRAL_API_KEY=""
# Modèle Mistral du brief (défaut : ministral-8b-2512 — 625k tokens/min).
# mistral-small-latest est limité à 20k tokens/min sur ce tier -> 429 sur un
# brief volumineux. mistral-medium/large peuvent être bloqués par le tier
# (403 tier_not_allowed) — tester avant de les mettre en prod. Voir ADR 0001.
MISTRAL_MODEL=""
